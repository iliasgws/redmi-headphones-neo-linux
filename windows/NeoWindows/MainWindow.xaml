<Window x:Class="NeoWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="REDMI Headphones Neo" Width="400" Height="620" MinHeight="500" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Icon="Assets/neo.ico">
 <Window.Resources>
  <Style x:Key="Pill" TargetType="Button"><Setter Property="Background" Value="#F0F1F3"/><Setter Property="Foreground" Value="#202329"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="White" CornerRadius="26" BorderBrush="#E3E6EB" BorderThickness="1"><Grid Margin="25,18,25,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><TextBlock Text="REDMI Headphones Neo" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Content="×" Width="32" Height="32" Padding="0" FontSize="21" Style="{StaticResource Pill}" Click="Close_Click"/></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Image x:Name="Animation" Height="225" Stretch="Uniform" Margin="0,14,0,18" RenderOptions.BitmapScalingMode="HighQuality"/>
   <StackPanel x:Name="BatteryRow" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock Text="Battery" VerticalAlignment="Center" Foreground="#565D67"/><Border BorderBrush="#343A40" BorderThickness="2" CornerRadius="3" Width="26" Height="14" Margin="8,0,3,0" Padding="2"><Rectangle x:Name="BatteryFill" Fill="#29C968" HorizontalAlignment="Left"/></Border><TextBlock x:Name="Battery" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
   <TextBlock x:Name="Status" Text="Looking for headphones…" Foreground="#666D77" TextAlignment="Center" TextWrapping="Wrap" Margin="8,0,8,14"/>
   <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource Pill}" Background="#1677F2" Foreground="White" Click="Connect_Click" Margin="0,0,0,8"/>
   <Button x:Name="SettingsButton" Content="Headphone settings" Style="{StaticResource Pill}" Click="Settings_Click" Visibility="Collapsed" Margin="0,0,0,8"/>
   <Border x:Name="Controls" Background="#F5F6F8" CornerRadius="20" Padding="16" Margin="0,8,0,0" Visibility="Collapsed"><StackPanel>
    <TextBlock Text="Noise control" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <UniformGrid Columns="3"><Button Content="Off" Tag="0" Click="Mode_Click" Style="{StaticResource Pill}" Margin="0,0,4,0"/><Button Content="ANC" Tag="1" Click="Mode_Click" Style="{StaticResource Pill}" Margin="2,0"/><Button Content="Transparency" Tag="2" Click="Mode_Click" Style="{StaticResource Pill}" FontSize="12" Margin="4,0,0,0"/></UniformGrid>
    <TextBlock x:Name="ModeText" Foreground="#69717C" Margin="0,10,0,0"/>
    <StackPanel x:Name="AncOptions" Visibility="Collapsed"><CheckBox x:Name="Adaptive" Content="Adaptive ANC" Click="Adaptive_Click" Margin="0,14,0,10"/><Slider x:Name="Strength" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="Strength_Released" KeyUp="Strength_KeyUp"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Light"/><TextBlock Grid.Column="1" Text="Balanced" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="Deep" HorizontalAlignment="Right"/></Grid></StackPanel>
   </StackPanel></Border>
   <Button x:Name="BluetoothButton" Content="Open Windows Bluetooth settings" Style="{StaticResource Pill}" Click="BluetoothSettings_Click" Visibility="Collapsed" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid></Border>
</Window>

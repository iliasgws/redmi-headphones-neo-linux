<Window x:Class="NeoWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="REDMI Headphones Neo" Width="400" Height="620" MinHeight="500" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Icon="Assets/neo.ico" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="Pill" TargetType="Button">
   <Setter Property="Background" Value="#EFF1F5"/><Setter Property="Foreground" Value="#252A33"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Switch" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="42" Height="24"><Border x:Name="track" Background="#C9CDD5" CornerRadius="12"/><Ellipse x:Name="thumb" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="#1677F2"/><Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="28"><Border Height="5" Background="#D6DAE2" CornerRadius="3"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="20" Height="20" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#1677F2" BorderBrush="White" BorderThickness="3" CornerRadius="10"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#F8F9FB" CornerRadius="26" BorderBrush="#E3E6EB" BorderThickness="1"><Grid Margin="24,18,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><TextBlock Text="REDMI Headphones Neo" Foreground="#171B22" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Content="×" Width="32" Height="32" Padding="0" FontSize="20" Style="{StaticResource Pill}" Click="Close_Click" ToolTip="Close"/></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Image x:Name="Animation" Height="225" Stretch="Uniform" Margin="0,10,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>
   <StackPanel x:Name="BatteryRow" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8"><TextBlock Text="Battery" VerticalAlignment="Center" Foreground="#565D67"/><Border BorderBrush="#343A40" BorderThickness="2" CornerRadius="3" Width="26" Height="14" Margin="8,0,3,0" Padding="2"><Rectangle x:Name="BatteryFill" Fill="#29C968" HorizontalAlignment="Left"/></Border><TextBlock x:Name="Battery" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
   <TextBlock x:Name="Status" Text="Looking for headphones…" Foreground="#69717E" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="8,0,8,14"/>
   <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource Pill}" Background="#1677F2" Foreground="White" Click="Connect_Click" Margin="0,0,0,4"/>
   <Button x:Name="SettingsButton" Content="Headphone settings" Style="{StaticResource Pill}" Click="Settings_Click" Visibility="Collapsed" Margin="0,0,0,4"/>
   <Border x:Name="Controls" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="20" Padding="16" Margin="0,12,0,0" Visibility="Collapsed"><StackPanel>
    <TextBlock Text="Noise control" Foreground="#171B22" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <UniformGrid Columns="3"><Button x:Name="ModeOff" Content="Off" Tag="0" Click="Mode_Click" Style="{StaticResource Pill}" Margin="0,0,4,0"/><Button x:Name="ModeAnc" Content="ANC" Tag="1" Click="Mode_Click" Style="{StaticResource Pill}" Margin="2,0"/><Button x:Name="ModeTransparency" Content="Transparency" Tag="2" Click="Mode_Click" Style="{StaticResource Pill}" FontSize="12" Margin="4,0,0,0"/></UniformGrid>
    <TextBlock x:Name="ModeText" Foreground="#69717E" FontSize="12" Margin="2,10,0,0"/>
    <StackPanel x:Name="AncOptions" Visibility="Collapsed"><Grid Margin="2,12,2,4"><TextBlock Text="Adaptive ANC" Foreground="#252A33" VerticalAlignment="Center"/><CheckBox x:Name="Adaptive" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Adaptive_Click" ToolTip="Adaptive ANC"/></Grid><Slider x:Name="Strength" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="Strength_Released" KeyUp="Strength_KeyUp"/><Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Light" Foreground="#69717E" FontSize="12"/><TextBlock Grid.Column="1" Text="Balanced" HorizontalAlignment="Center" Foreground="#69717E" FontSize="12"/><TextBlock Grid.Column="2" Text="Deep" HorizontalAlignment="Right" Foreground="#69717E" FontSize="12"/></Grid></StackPanel>
   </StackPanel></Border>
   <Button x:Name="BluetoothButton" Content="Open Windows Bluetooth settings" Style="{StaticResource Pill}" Click="BluetoothSettings_Click" Visibility="Collapsed" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid></Border>
</Window>
